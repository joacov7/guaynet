# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Guaynet WISP"
# Generate with: openssl rand -hex 32
# The backend will not start with this sample value.
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also validated at startup (must be a real Fernet key). Existing plain-text credentials keep working
# after you set it and are encrypted the next time they are saved.
ENCRYPTION_KEY=your-fernet-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://guaynet:guaynet@localhost:5432/guaynet

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. The Android app (Capacitor) calls the API from https://localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost

# ─── Initial superuser ────────────────────────────────────────────────────────
# Used only to create the admin the first time (an existing admin is not touched).
# The backend refuses to create it with an empty or default password: set a real one.
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=changeme
FIRST_SUPERUSER_EMAIL=admin@guaynet.local

# ─── Guaynet Seguridad ────────────────────────────────────────────────────────
# BEAT adapter: "mock" (default, simulated data) or "real" (requires official API docs)
BEAT_ADAPTER=mock
# With the mock adapter, BEAT polling is OFF so simulated events never become real
# alerts. Set to 1 only in local development to generate simulated events.
# BEAT_MOCK_POLLING=1

# Push notifications for the Android app (Firebase Cloud Messaging).
# Path to the service account JSON (Firebase console → Project settings →
# Service accounts). Never commit that file. Empty = simulated push (logs only).
FCM_SERVICE_ACCOUNT_FILE=

# Set to 1 in local development to skip the SECRET_KEY / ENCRYPTION_KEY / admin-password startup checks
# Never set in production
# GUAYNET_SKIP_SECURITY_CHECK=1
